# Copy this file to hardware/.env on the Pi and fill in the secret key.
# .env is ignored by git, so the secret never reaches GitHub.
SUPABASE_URL=https://qlfqgyrwrihwomadqjsh.supabase.co
SUPABASE_SERVICE_KEY=paste-the-sb_secret-key-here

# Bluetooth speaker (speaker.py)
SPEAKER_ID=brick
SPEAKER_NAME=Buzzkill speaker
# Your speaker's address, from `bluetoothctl devices`. The Pi reconnects to it if it drops.
BT_SPEAKER_MAC=
# Optional: a different text-to-speech command. The roast text is added at the end.
# TTS_CMD=espeak-ng -v en-us -s 160 -a 200
