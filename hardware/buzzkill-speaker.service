# Runs speaker.py on boot as a *user* service, so it can reach the Bluetooth audio (PipeWire/PulseAudio).
# Install: see "Bluetooth speaker" in hardware/README.md
[Unit]
Description=Buzzkill roast speaker
After=network-online.target pipewire.service pipewire-pulse.service

[Service]
WorkingDirectory=%h/Buzzkill-PSU/hardware
ExecStart=/usr/bin/python3 %h/Buzzkill-PSU/hardware/speaker.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
